# Copia este archivo como .env.local y ajústalo.
#
# Las tres son NEXT_PUBLIC_*, así que Next las incrusta en el paquete al
# compilar y acaban en el navegador de cualquiera. No pongas aquí nada que no
# pueda ser público: la clave de Stripe que va en este lado es la publicable,
# la que empieza por pk_, nunca la secreta.
#
# Y como se incrustan al compilar, cambiarlas exige reconstruir, no
# reiniciar. En Render eso significa desplegar con «Clear build cache».

# Dirección de la API, con /api incluido.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Clave publicable de Stripe. Sin ella la pantalla de pago no llega a montar
# el formulario; el resto de la aplicación funciona igual.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Dirección canónica del sitio. La usan el sitemap, robots.txt y las
# etiquetas de Open Graph, que necesitan direcciones absolutas. Tiene un valor
# por defecto, así que en local puedes dejarla sin poner.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo en el servidor ---------------------------------------------------
# Esta no es NEXT_PUBLIC_: se lee al arrancar y nunca llega al navegador.
#
# El navegador llama a /api en el frontend, que lo reenvía a la API. Con este
# secreto, el mismo que en la API, el frontend le pasa la dirección de cada
# visitante y la API la cree; sin él, todo lo que llega por aquí comparte un
# solo límite de peticiones. En local no hace falta.
# PROXY_SECRETO=
