# Capa de IA. Sin clave el asistente sigue funcionando con el diccionario de
# oficios, así que dejarla vacía es una opción válida y no rompe nada.
ANTHROPIC_API_KEY=
IA_ACTIVA=true
IA_MODELO=claude-haiku-4-5-20251001
# Tope mensual en céntimos, comprobado antes de cada llamada.
IA_TOPE_MENSUAL_CENTIMOS=100

# Redis. Opcional: sin esta variable el limitador cuenta en memoria, los
# sockets se quedan en una instancia y no hay caché, que es como funcionaba
# antes de existir. Con ella, las tres cosas pasan a compartirse.
REDIS_URL=

# Diagnóstico de red. Apagado de fábrica: sin esta variable la ruta responde
# 404. Sirve para medir cuántos saltos mete el proxy delante de la aplicación
# y ajustar «trust proxy». Se pone, se mide y se quita.
DIAGNOSTICO_TOKEN=
