# Copia este archivo como .env y ajústalo. Lo que está comentado es opcional:
# la aplicación arranca sin ello y lo dice en el registro al hacerlo.

NODE_ENV=development
PORT=3001

# --- Base de datos ---------------------------------------------------------
# En local se usan los campos sueltos, que es lo que levanta docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=servilocal_user
DB_PASSWORD=servilocal_dev_2026
DB_DATABASE=servilocal

# En un despliegue se usa la cadena completa y los campos de arriba se
# ignoran. Tiene prioridad sobre ellos.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/basededatos?sslmode=require

# El certificado del servidor se valida por defecto: aceptarlo sin comprobar
# deja la conexión expuesta a un intermediario. Solo para proveedores con
# certificado autofirmado.
# DB_SSL_PERMISIVO=false

# --- Sesiones --------------------------------------------------------------
JWT_SECRET=servilocal_jwt_secret_dev_2026
JWT_EXPIRATION=24h

# --- Orígenes permitidos ---------------------------------------------------
# Lista separada por comas. Sin esto, el navegador rechaza las respuestas.
CORS_ORIGINS=http://localhost:3000
# Se usa para construir enlaces absolutos hacia la aplicación.
FRONTEND_URL=http://localhost:3000

# --- Pagos -----------------------------------------------------------------
# En modo de prueba, las dos empiezan por sk_test_ y whsec_. Sin la segunda,
# la ruta del webhook responde 503 en vez de aceptar avisos sin verificar.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Capa de IA ------------------------------------------------------------
# Sin clave el asistente sigue funcionando con el diccionario de oficios, así
# que dejarla vacía es una opción válida y no rompe nada.
ANTHROPIC_API_KEY=
IA_ACTIVA=true
IA_MODELO=claude-haiku-4-5-20251001
# Tope mensual en céntimos, comprobado antes de cada llamada. La cuenta
# interna se lleva en milésimas de céntimo para no inflarla redondeando.
IA_TOPE_MENSUAL_CENTIMOS=100
# Techo de tokens de salida, que también acota el coste del peor caso.
# IA_MAX_TOKENS_SALIDA=2000
# IA_TIEMPO_ESPERA_MS=20000

# --- Redis -----------------------------------------------------------------
# Opcional: sin esta variable el limitador cuenta en memoria, los sockets se
# quedan en una instancia y no hay caché, que es como funcionaba antes de
# existir. Con ella, las tres cosas pasan a compartirse.
REDIS_URL=

# --- Observabilidad --------------------------------------------------------
# Sin DSN no se envía nada y la aplicación arranca igual, diciéndolo.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Siembra ---------------------------------------------------------------
# Sin ADMIN_PASSWORD, la siembra crea únicamente el administrador de
# demostración, que es de solo lectura. Es lo que debe quedar en un despliegue
# público: la contraseña de demostración se publica en la pantalla de acceso,
# así que un administrador con permisos reales no puede usarla. La semilla lo
# rechaza explícitamente.
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@servilocal.com

# --- Límites ---------------------------------------------------------------
# Sube el límite de intentos de acceso. Solo para entornos de prueba, donde
# una batería entera entra muchas veces desde la misma dirección.
# THROTTLE_AUTH_LIMIT=100

# --- Diagnóstico -----------------------------------------------------------
# Apagado de fábrica: sin esta variable la ruta responde 404, igual que una
# que no existe. Sirve para medir cuántos saltos mete el proxy delante de la
# aplicación y ajustar «trust proxy». Se pone, se mide y se quita.
DIAGNOSTICO_TOKEN=
